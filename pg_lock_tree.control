# pg_lock_tree extension
comment = 'Readable lock-wait trees: who blocks whom, the root blocker, and how long everyone has waited'
default_version = '1.1.1'
# 1.1.1 changes no SQL. It exists so the version records that the documentation was fixed and the
# release tooling gained a check, and so that upgrading from 1.1.0 does not require dropping the
# extension, which would take lock_tree_history with it. See pg_lock_tree--1.1.0--1.1.1.sql.
relocatable = false
trusted = false
