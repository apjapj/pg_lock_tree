# pg_lock_tree extension
comment = 'Readable lock-wait trees: who blocks whom, the root blocker, and how long everyone has waited'
default_version = '1.1.0'
# 1.1.0 adds a window parameter to lock_tree_incidents() and INCLUDE (query_id) to one index.
# No function changes what it returns for the arguments it already accepted.
relocatable = false
trusted = false
