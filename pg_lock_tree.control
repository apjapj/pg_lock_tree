# pg_lock_tree extension
comment = 'Readable lock-wait trees: who blocks whom, the root blocker, and how long everyone has waited'
default_version = '1.1.14'
# 1.1.10 adds a DIRECT pg_lock_tree--1.1.8--1.1.10.sql beside the normal 1.1.9--1.1.10 step, and
# that is deliberate: the dependents check in pg_lock_tree--1.1.8--1.1.9.sql named the wrong object
# and missed views outside the extension's schema, 1.1.9 is a frozen tag, and PostgreSQL takes the
# shortest path, so a 1.1.8 database updating to 1.1.10 runs the corrected check and never the old
# one. An explicit UPDATE TO '1.1.9' still runs the old one. See CHANGELOG.md.
#
# 1.1.2 changes one function body, lock_tree_incidents(), for speed and not for output: the same rows
# and arrays as 1.1.1, measured on the standard fixture and on small fixtures with NULLs in them.
# See pg_lock_tree--1.1.1--1.1.2.sql.
#
# 1.1.8 adds lock_tree_archive_find(), the read side of the cold tier and the first shipped function
# to read lock_tree_history_archive. It requires a since window, enforced by a plpgsql guard, and the
# bound is measured rather than stylistic. See pg_lock_tree--1.1.7--1.1.8.sql.
#
# 1.1.7 adds ONE column to lock_tree_history_size(), archive_bytes, appended after the eight it
# already returned, and changes no value any existing column produces. See
# pg_lock_tree--1.1.6--1.1.7.sql, which also records why an archive row count, oldest and newest
# were removed: each needs a full scan, and this function's one existing flaw is that its cost
# already follows retention.
#
# 1.1.6 adds a cold tier: lock_tree_history_archive, indexed by BRIN and nothing else, and
# lock_tree_archive() to move history into it in committed batches. It adds nothing to the read
# path and no shipped function reads the archive. See pg_lock_tree--1.1.5--1.1.6.sql.
relocatable = false
trusted = false
